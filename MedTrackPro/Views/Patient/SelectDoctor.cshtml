@model DataLibrary.ViewModels.Patient.SelectDoctorViewModel

<div class="container">
    <div class="row min-vh-100 mt-2">
        <div class="col-md-4 border border-1 rounded-1 py-md-5 py-3">
            <div class="">
                <h3 class="fw-bold text-center">Categories</h3>
                @if(Model.doctorCategories != null && Model.doctorCategories.Any())
                {
                    foreach(var category in Model.doctorCategories)
                    {
                        <a asp-controller="Patient" asp-action="FindDoctorsByCategory" asp-route-id="@category.CategoryId" class="text-decoration-none" style="cursor:pointer;">
                            <div class="d-flex justify-content-start m-3 border border-1 rounded-2">
                                <img class="img-fluid rounded-1" style="width: 50px;" src="~/images/img1.jpg" />
                                <span class="fw-semibold mx-2" style="margin: auto;">@category.Name</span>
                            </div>
                        </a>
                    }
                }
               
            </div>
        </div>
        <div class="col-md-8 min-vh-100 overflow-y-auto border border-1 rounded-1 py-md-5 py-3" style="max-height: 450px;">
            <div class="">
                <h3 class="fw-bold text-center">List Of Doctors</h3>
                @if (Model.Doctors != null && Model.Doctors.Any())
                {
                    foreach (var doctor in Model.Doctors)
                    {
                        <a asp-controller="Doctor" asp-action="Profile" asp-route-id="@doctor.UserId" class="text-decoration-none text-black" style="cursor:pointer;">
                            <div class="d-flex justify-content-start m-3 border border-1 rounded-2">
                                @if (doctor.PhotoUrl == null)
                                {
                                    <img class="img-fluid rounded-1 w-25" src="~/images/img1.jpg" />
                                }
                                else
                                {
                                    <img class="img-fluid rounded-1 w-25" src="@doctor.PhotoUrl" />
                                }
                                <div class="my-2">
                                    <span class="fw-semibold mx-2">@doctor.FirstName</span>
                                    <p class="fw-semibold mx-2"><span class="fw-medium">Years of Experience : </span>@doctor.YearsOfExperience yrs</p>
                                    @if (doctor.ShortDescription != null)
                                    {
                                        <p class="fw-medium mx-2">@doctor.ShortDescription</p>
                                    }
                                </div>
                            </div>
                        </a>
                    }
                }
               
               
            </div>
        </div>
    </div>
</div>